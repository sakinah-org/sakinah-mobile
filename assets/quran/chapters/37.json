   "page": 451
  },
  {
   "id": 139,
   "text": "وَإِنَّ يُونُسَ لَمِنَ ٱلۡمُرۡسَلِينَ",
   "transliteration": "Wainna yoonusa lamina almursaleena",
   "page": 451
  },
  {
   "id": 140,
   "text": "إِذۡ أَبَقَ إِلَى ٱلۡفُلۡكِ ٱلۡمَشۡحُونِ",
   "transliteration": "Ith abaqa ila alfulki almashhooni",
   "page": 451
  },
  {
   "id": 141,
   "text": "فَسَاهَمَ فَكَانَ مِنَ ٱلۡمُدۡحَضِينَ",
   "transliteration": "Fasahama fakana mina almudhadeena",
   "page": 451
  },
  {
   "id": 142,
   "text": "فَٱلۡتَقَمَهُ ٱلۡحُوتُ وَهُوَ مُلِيمٞ",
   "transliteration": "Failtaqamahu alhootu wahuwa muleemun",
   "page": 451
  },
  {
   "id": 143,
   "text": "فَلَوۡلَآ أَنَّهُۥ كَانَ مِنَ ٱلۡمُسَبِّحِينَ",
   "transliteration": "Falawla annahu kana mina almusabbiheena",
   "page": 451
  },
  {
   "id": 144,
   "text": "لَلَبِثَ فِي بَطۡنِهِۦٓ إِلَىٰ يَوۡمِ يُبۡعَثُونَ",
   "transliteration": "Lalabitha fee batnihi ila yawmi yubAAathoona",
   "page": 451
  },
  {
   "id": 145,
   "text": "۞فَنَبَذۡنَٰهُ بِٱلۡعَرَآءِ وَهُوَ سَقِيمٞ",
