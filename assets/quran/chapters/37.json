   "text": "وَأَرۡسَلۡنَٰهُ إِلَىٰ مِاْئَةِ أَلۡفٍ أَوۡ يَزِيدُونَ",
   "transliteration": "Waarsalnahu ila miati alfin aw yazeedoona",
   "page": 451
  },
  {
   "id": 148,
   "text": "فَـَٔامَنُواْ فَمَتَّعۡنَٰهُمۡ إِلَىٰ حِينٖ",
   "transliteration": "Faamanoo famattaAAnahum ila heenin",
   "page": 451
  },
  {
   "id": 149,
   "text": "فَٱسۡتَفۡتِهِمۡ أَلِرَبِّكَ ٱلۡبَنَاتُ وَلَهُمُ ٱلۡبَنُونَ",
   "transliteration": "Faistaftihim alirabbika albanatu walahumu albanoona",
   "page": 451
  },
  {
   "id": 150,
   "text": "أَمۡ خَلَقۡنَا ٱلۡمَلَـٰٓئِكَةَ إِنَٰثٗا وَهُمۡ شَٰهِدُونَ",
   "transliteration": "Am khalaqna almalaikata inathan wahum shahidoona",
   "page": 451
  },
  {
   "id": 151,
   "text": "أَلَآ إِنَّهُم مِّنۡ إِفۡكِهِمۡ لَيَقُولُونَ",
   "transliteration": "Ala innahum min ifkihim layaqooloona",
   "page": 451
  },
  {
   "id": 152,
   "text": "وَلَدَ ٱللَّهُ وَإِنَّهُمۡ لَكَٰذِبُونَ",
   "transliteration": "Walada Allahu wainnahum lakathiboona",
   "page": 451
  },
  {
   "id": 153,
   "text": "أَصۡطَفَى ٱلۡبَنَاتِ عَلَى ٱلۡبَنِينَ",
   "transliteration": "Astafa albanati AAala albaneena",
   "page": 451
  },
  {
   "id": 154,
   "text": "مَا لَكُمۡ كَيۡفَ تَحۡكُمُونَ",
   "transliteration": "Ma lakum kayfa tahkumoona",
   "page": 452
  },
  {
   "id": 155,
   "text": "أَفَلَا تَذَكَّرُونَ",
   "transliteration": "Afala tathakkaroona",
   "page": 452
  },
  {
   "id": 156,
   "text": "أَمۡ لَكُمۡ سُلۡطَٰنٞ مُّبِينٞ",
   "transliteration": "Am lakum sultanun mubeenun",
   "page": 452
  },
  {
   "id": 157,
   "text": "فَأۡتُواْ بِكِتَٰبِكُمۡ إِن كُنتُمۡ صَٰدِقِينَ",
   "transliteration": "Fatoo bikitabikum in kuntum sadiqeena",
   "page": 452
  },
  {
   "id": 158,
   "text": "وَجَعَلُواْ بَيۡنَهُۥ وَبَيۡنَ ٱلۡجِنَّةِ نَسَبٗاۚ وَلَقَدۡ عَلِمَتِ ٱلۡجِنَّةُ إِنَّهُمۡ لَمُحۡضَرُونَ",
   "transliteration": "WajaAAaloo baynahu wabayna aljinnati nasaban walaqad AAalimati aljinnatu innahum lamuhdaroona",
   "page": 452
  },
  {
   "id": 159,
   "text": "سُبۡحَٰنَ ٱللَّهِ عَمَّا يَصِفُونَ",
   "transliteration": "Subhana Allahi AAamma yasifoona",
   "page": 452
  },
  {
   "id": 160,
   "text": "إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ",
   "transliteration": "Illa AAibada Allahi almukhlaseena",
   "page": 452
  },
  {
   "id": 161,
   "text": "فَإِنَّكُمۡ وَمَا تَعۡبُدُونَ",
   "transliteration": "Fainnakum wama taAAbudoona",
   "page": 452
  },
  {
   "id": 162,
   "text": "مَآ أَنتُمۡ عَلَيۡهِ بِفَٰتِنِينَ",
   "transliteration": "Ma antum AAalayhi bifatineena",
   "page": 452
  },
  {
   "id": 163,
   "text": "إِلَّا مَنۡ هُوَ صَالِ ٱلۡجَحِيمِ",
   "transliteration": "Illa man huwa sali aljaheemi",
   "page": 452
  },
  {
   "id": 164,
   "text": "وَمَامِنَّآ إِلَّا لَهُۥ مَقَامٞ مَّعۡلُومٞ",
   "transliteration": "Wama minna illa lahu maqamun maAAloomun",
   "page": 452
  },
  {
   "id": 165,
   "text": "وَإِنَّا لَنَحۡنُ ٱلصَّآفُّونَ",
   "transliteration": "Wainna lanahnu alssaffoona",
   "page": 452
  },
  {
   "id": 166,
   "text": "وَإِنَّا لَنَحۡنُ ٱلۡمُسَبِّحُونَ",
   "transliteration": "Wainna lanahnu almusabbihoona",
   "page": 452
  },
  {
   "id": 167,
   "text": "وَإِن كَانُواْ لَيَقُولُونَ",
   "transliteration": "Wain kanoo layaqooloona",
   "page": 452
  },
  {
   "id": 168,
   "text": "لَوۡ أَنَّ عِندَنَا ذِكۡرٗا مِّنَ ٱلۡأَوَّلِينَ",
   "transliteration": "Law anna AAindana thikran mina alawwaleena",
   "page": 452
  },
  {
   "id": 169,
   "text": "لَكُنَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ",
   "transliteration": "Lakunna AAibada Allahi almukhlaseena",
   "page": 452
  },
  {
   "id": 170,
   "text": "فَكَفَرُواْ بِهِۦۖ فَسَوۡفَ يَعۡلَمُونَ",
   "transliteration": "Fakafaroo bihi fasawfa yaAAlamoona",
   "page": 452
  },
  {
   "id": 171,
   "text": "وَلَقَدۡ سَبَقَتۡ كَلِمَتُنَا لِعِبَادِنَا ٱلۡمُرۡسَلِينَ",
   "transliteration": "Walaqad sabaqat kalimatuna liAAibadina almursaleena",
   "page": 452
  },
  {
   "id": 172,
   "text": "إِنَّهُمۡ لَهُمُ ٱلۡمَنصُورُونَ",
   "transliteration": "Innahum lahumu almansooroona",
   "page": 452
  },
  {
   "id": 173,
   "text": "وَإِنَّ جُندَنَا لَهُمُ ٱلۡغَٰلِبُونَ",
   "transliteration": "Wainna jundana lahumu alghaliboona",
   "page": 452
  },
  {
   "id": 174,
   "text": "فَتَوَلَّ عَنۡهُمۡ حَتَّىٰ حِينٖ",
   "transliteration": "Fatawalla AAanhum hatta heenin",
   "page": 452
  },
  {
   "id": 175,
   "text": "وَأَبۡصِرۡهُمۡ فَسَوۡفَ يُبۡصِرُونَ",
   "transliteration": "Waabsirhum fasawfa yubsiroona",
   "page": 452
  },
  {
   "id": 176,
   "text": "أَفَبِعَذَابِنَا يَسۡتَعۡجِلُونَ",
   "transliteration": "AfabiAAathabina yastaAAjiloona",
   "page": 452
  },
  {
   "id": 177,
   "text": "فَإِذَا نَزَلَ بِسَاحَتِهِمۡ فَسَآءَ صَبَاحُ ٱلۡمُنذَرِينَ",
   "transliteration": "Faitha nazala bisahatihim fasaa sabahu almunthareena",
   "page": 452
  },
  {
   "id": 178,
   "text": "وَتَوَلَّ عَنۡهُمۡ حَتَّىٰ حِينٖ",
   "transliteration": "Watawalla AAanhum hatta heenin",
   "page": 452
  },
  {
   "id": 179,
   "text": "وَأَبۡصِرۡ فَسَوۡفَ يُبۡصِرُونَ",
   "transliteration": "Waabsir fasawfa yubsiroona",
   "page": 452
  },
  {
   "id": 180,
   "text": "سُبۡحَٰنَ رَبِّكَ رَبِّ ٱلۡعِزَّةِ عَمَّا يَصِفُونَ",
   "transliteration": "Subhana rabbika rabbi alAAizzati AAamma yasifoona",
   "page": 452
  },
  {
   "id": 181,
   "text": "وَسَلَٰمٌ عَلَى ٱلۡمُرۡسَلِينَ",
   "transliteration": "Wasalamun AAala almursaleena",
   "page": 452
  },
  {
   "id": 182,
   "text": "وَٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَٰلَمِينَ",
   "transliteration": "Waalhamdu lillahi rabbi alAAalameena",
   "page": 452
  }
 ]
}