{
 "id": 37,
 "name": "الصافات",
 "transliteration": "As-Saffat",
 "type": "meccan",
 "total_verses": 182,
 "verses": [
  {
   "id": 1,
   "text": "وَٱلصَّـٰٓفَّـٰتِ صَفّٗا",
   "transliteration": "Waalssaffati saffan",
   "page": 446
  },
  {
   "id": 2,
   "text": "فَٱلزَّـٰجِرَٰتِ زَجۡرٗا",
   "transliteration": "Faalzzajirati zajran",
   "page": 446
  },
  {
   "id": 3,
   "text": "فَٱلتَّـٰلِيَٰتِ ذِكۡرًا",
   "transliteration": "Faalttaliyati thikran",
   "page": 446
  },
  {
   "id": 4,
   "text": "إِنَّ إِلَٰهَكُمۡ لَوَٰحِدٞ",
   "transliteration": "Inna ilahakum lawahidun",
   "page": 446
  },
  {
   "id": 5,
   "text": "رَّبُّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَا وَرَبُّ ٱلۡمَشَٰرِقِ",
   "transliteration": "Rabbu alssamawati waalardi wama baynahuma warabbu almashariqi",
   "page": 446
  },
  {
   "id": 6,
   "text": "إِنَّا زَيَّنَّا ٱلسَّمَآءَ ٱلدُّنۡيَا بِزِينَةٍ ٱلۡكَوَاكِبِ",
   "transliteration": "Inna zayyanna alssamaa alddunya bizeenatin alkawakibi",
   "page": 446
  },
  {
   "id": 7,
   "text": "وَحِفۡظٗا مِّن كُلِّ شَيۡطَٰنٖ مَّارِدٖ",
   "transliteration": "Wahifthan min kulli shaytanin maridin",
   "page": 446
  },
  {
   "id": 8,
   "text": "لَّا يَسَّمَّعُونَ إِلَى ٱلۡمَلَإِ ٱلۡأَعۡلَىٰ وَيُقۡذَفُونَ مِن كُلِّ جَانِبٖ",
   "transliteration": "La yassammaAAoona ila almalai alaAAla wayuqthafoona min kulli janibin",
   "page": 446
  },
  {
   "id": 9,
   "text": "دُحُورٗاۖ وَلَهُمۡ عَذَابٞ وَاصِبٌ",
   "transliteration": "Duhooran walahum AAathabun wasibun",
   "page": 446
  },
  {
   "id": 10,
   "text": "إِلَّا مَنۡ خَطِفَ ٱلۡخَطۡفَةَ فَأَتۡبَعَهُۥ شِهَابٞ ثَاقِبٞ",
   "transliteration": "Illa man khatifa alkhatfata faatbaAAahu shihabun thaqibun",
   "page": 446
  },
  {
   "id": 11,
   "text": "فَٱسۡتَفۡتِهِمۡ أَهُمۡ أَشَدُّ خَلۡقًا أَم مَّنۡ خَلَقۡنَآۚ إِنَّا خَلَقۡنَٰهُم مِّن طِينٖ لَّازِبِۭ",
   "transliteration": "Faistaftihim ahum ashaddu khalqan am man khalaqna inna khalaqnahum min teenin lazibin",
   "page": 446
  },
  {
   "id": 12,
   "text": "بَلۡ عَجِبۡتَ وَيَسۡخَرُونَ",
   "transliteration": "Bal AAajibta wayaskharoona",
   "page": 446
  },
  {
   "id": 13,
   "text": "وَإِذَا ذُكِّرُواْ لَا يَذۡكُرُونَ",
   "transliteration": "Waitha thukkiroo la yathkuroona",
   "page": 446
  },
  {
   "id": 14,
   "text": "وَإِذَا رَأَوۡاْ ءَايَةٗ يَسۡتَسۡخِرُونَ",
   "transliteration": "Waitha raaw ayatan yastaskhiroona",
   "page": 446
  },
  {
   "id": 15,
   "text": "وَقَالُوٓاْ إِنۡ هَٰذَآ إِلَّا سِحۡرٞ مُّبِينٌ",
   "transliteration": "Waqaloo in hatha illa sihrun mubeenun",
   "page": 446
  },
  {
   "id": 16,
   "text": "أَءِذَا مِتۡنَا وَكُنَّا تُرَابٗا وَعِظَٰمًا أَءِنَّا لَمَبۡعُوثُونَ",
   "transliteration": "Aitha mitna wakunna turaban waAAithaman ainna lamabAAoothoona",
   "page": 446
  },
  {
   "id": 17,
   "text": "أَوَءَابَآؤُنَا ٱلۡأَوَّلُونَ",
   "transliteration": "Awaabaona alawwaloona",
   "page": 446
  },
  {
   "id": 18,
   "text": "قُلۡ نَعَمۡ وَأَنتُمۡ دَٰخِرُونَ",
   "transliteration": "Qul naAAam waantum dakhiroona",
   "page": 446
  },
  {
   "id": 19,
   "text": "فَإِنَّمَا هِيَ زَجۡرَةٞ وَٰحِدَةٞ فَإِذَا هُمۡ يَنظُرُونَ",
   "transliteration": "Fainnama hiya zajratun wahidatun faitha hum yanthuroona",
   "page": 446
  },
  {
   "id": 20,
   "text": "وَقَالُواْ يَٰوَيۡلَنَا هَٰذَا يَوۡمُ ٱلدِّينِ",
   "transliteration": "Waqaloo ya waylana hatha yawmu alddeeni",
   "page": 446
  },
  {
   "id": 21,
   "text": "هَٰذَا يَوۡمُ ٱلۡفَصۡلِ ٱلَّذِي كُنتُم بِهِۦ تُكَذِّبُونَ",
   "transliteration": "Hatha yawmu alfasli allathee kuntum bihi tukaththiboona",
   "page": 446
  },
  {
   "id": 22,
   "text": "۞ٱحۡشُرُواْ ٱلَّذِينَ ظَلَمُواْ وَأَزۡوَٰجَهُمۡ وَمَا كَانُواْ يَعۡبُدُونَ",
   "transliteration": "Ohshuroo allatheena thalamoo waazwajahum wama kanoo yaAAbudoona",
   "page": 446
  },
  {
   "id": 23,
   "text": "مِن دُونِ ٱللَّهِ فَٱهۡدُوهُمۡ إِلَىٰ صِرَٰطِ ٱلۡجَحِيمِ",
   "transliteration": "Min dooni Allahi faihdoohum ila sirati aljaheemi",
   "page": 446
  },
  {
   "id": 24,
   "text": "وَقِفُوهُمۡۖ إِنَّهُم مَّسۡـُٔولُونَ",
   "transliteration": "Waqifoohum innahum masooloona",
   "page": 446
  },
  {
   "id": 25,
   "text": "مَا لَكُمۡ لَا تَنَاصَرُونَ",
   "transliteration": "Ma lakum la tanasaroona",
   "page": 447
  },
  {
   "id": 26,
   "text": "بَلۡ هُمُ ٱلۡيَوۡمَ مُسۡتَسۡلِمُونَ",
   "transliteration": "Bal humu alyawma mustaslimoona",
   "page": 447
  },
  {
   "id": 27,
   "text": "وَأَقۡبَلَ بَعۡضُهُمۡ عَلَىٰ بَعۡضٖ يَتَسَآءَلُونَ",
   "transliteration": "Waaqbala baAAduhum AAala baAAdin yatasaaloona",
   "page": 447
  },
  {
   "id": 28,
   "text": "قَالُوٓاْ إِنَّكُمۡ كُنتُمۡ تَأۡتُونَنَا عَنِ ٱلۡيَمِينِ",
   "transliteration": "Qaloo innakum kuntum tatoonana AAani alyameeni",
   "page": 447
  },
  {
   "id": 29,
   "text": "قَالُواْ بَل لَّمۡ تَكُونُواْ مُؤۡمِنِينَ",
   "transliteration": "Qaloo bal lam takoonoo mumineena",
   "page": 447
  },
  {
   "id": 30,
   "text": "وَمَا كَانَ لَنَا عَلَيۡكُم مِّن سُلۡطَٰنِۭۖ بَلۡ كُنتُمۡ قَوۡمٗا طَٰغِينَ",
   "transliteration": "Wama kana lana AAalaykum min sultanin bal kuntum qawman tagheena",
   "page": 447
  },
  {
   "id": 31,
   "text": "فَحَقَّ عَلَيۡنَا قَوۡلُ رَبِّنَآۖ إِنَّا لَذَآئِقُونَ",
   "transliteration": "Fahaqqa AAalayna qawlu rabbina inna lathaiqoona",
   "page": 447
  },
  {
   "id": 32,
   "text": "فَأَغۡوَيۡنَٰكُمۡ إِنَّا كُنَّا غَٰوِينَ",
   "transliteration": "Faaghwaynakum inna kunna ghaweena",
   "page": 447
  },
  {
   "id": 33,
   "text": "فَإِنَّهُمۡ يَوۡمَئِذٖ فِي ٱلۡعَذَابِ مُشۡتَرِكُونَ",
   "transliteration": "Fainnahum yawmaithin fee alAAathabi mushtarikoona",
   "page": 447
  },
  {
   "id": 34,
   "text": "إِنَّا كَذَٰلِكَ نَفۡعَلُ بِٱلۡمُجۡرِمِينَ",
   "transliteration": "Inna kathalika nafAAalu bialmujrimeena",
   "page": 447
  },
  {
   "id": 35,
   "text": "إِنَّهُمۡ كَانُوٓاْ إِذَا قِيلَ لَهُمۡ لَآ إِلَٰهَ إِلَّا ٱللَّهُ يَسۡتَكۡبِرُونَ",
   "transliteration": "Innahum kanoo itha qeela lahum la ilaha illa Allahu yastakbiroona",
   "page": 447
  },
  {
   "id": 36,
   "text": "وَيَقُولُونَ أَئِنَّا لَتَارِكُوٓاْ ءَالِهَتِنَا لِشَاعِرٖ مَّجۡنُونِۭ",
   "transliteration": "Wayaqooloona ainna latarikoo alihatina lishaAAirin majnoonin",
   "page": 447
  },
  {
   "id": 37,
   "text": "بَلۡ جَآءَ بِٱلۡحَقِّ وَصَدَّقَ ٱلۡمُرۡسَلِينَ",
   "transliteration": "Bal jaa bialhaqqi wasaddaqa almursaleena",
   "page": 447
  },
  {
   "id": 38,
   "text": "إِنَّكُمۡ لَذَآئِقُواْ ٱلۡعَذَابِ ٱلۡأَلِيمِ",
   "transliteration": "Innakum lathaiqoo alAAathabi alaleemi",
   "page": 447
  },
  {
   "id": 39,
   "text": "وَمَا تُجۡزَوۡنَ إِلَّا مَا كُنتُمۡ تَعۡمَلُونَ",
   "transliteration": "Wama tujzawna illa ma kuntum taAAmaloona",
   "page": 447
  },
  {
   "id": 40,
   "text": "إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ",
   "transliteration": "Illa AAibada Allahi almukhlaseena",
   "page": 447
  },
  {
   "id": 41,
   "text": "أُوْلَـٰٓئِكَ لَهُمۡ رِزۡقٞ مَّعۡلُومٞ",
   "transliteration": "Olaika lahum rizqun maAAloomun",
   "page": 447
  },
  {
   "id": 42,
   "text": "فَوَٰكِهُ وَهُم مُّكۡرَمُونَ",
   "transliteration": "Fawakihu wahum mukramoona",
   "page": 447
  },
  {
   "id": 43,
   "text": "فِي جَنَّـٰتِ ٱلنَّعِيمِ",
   "transliteration": "Fee jannati alnnaAAeemi",
   "page": 447
  },
  {
   "id": 44,
   "text": "عَلَىٰ سُرُرٖ مُّتَقَٰبِلِينَ",
   "transliteration": "AAala sururin mutaqabileena",
   "page": 447
  },
  {
   "id": 45,
   "text": "يُطَافُ عَلَيۡهِم بِكَأۡسٖ مِّن مَّعِينِۭ",
   "transliteration": "Yutafu AAalayhim bikasin min maAAeenin",
   "page": 447
  },
  {
   "id": 46,
   "text": "بَيۡضَآءَ لَذَّةٖ لِّلشَّـٰرِبِينَ",
   "transliteration": "Baydaa laththatin lilshsharibeena",
   "page": 447
  },
  {
   "id": 47,
   "text": "لَا فِيهَا غَوۡلٞ وَلَا هُمۡ عَنۡهَا يُنزَفُونَ",
   "transliteration": "La feeha ghawlun wala hum AAanha yunzafoona",
   "page": 447
  },
  {
   "id": 48,
   "text": "وَعِندَهُمۡ قَٰصِرَٰتُ ٱلطَّرۡفِ عِينٞ",
   "transliteration": "WaAAindahum qasiratu alttarfi AAeenun",
   "page": 447
  },
  {
   "id": 49,
   "text": "كَأَنَّهُنَّ بَيۡضٞ مَّكۡنُونٞ",
   "transliteration": "Kaannahunna baydun maknoonun",
   "page": 447
  },
  {
   "id": 50,
   "text": "فَأَقۡبَلَ بَعۡضُهُمۡ عَلَىٰ بَعۡضٖ يَتَسَآءَلُونَ",
   "transliteration": "Faaqbala baAAduhum AAala baAAdin yatasaaloona",
   "page": 447
  },
  {
   "id": 51,
   "text": "قَالَ قَآئِلٞ مِّنۡهُمۡ إِنِّي كَانَ لِي قَرِينٞ",
   "transliteration": "Qala qailun minhum innee kana lee qareenun",
   "page": 447
  },
  {
   "id": 52,
   "text": "يَقُولُ أَءِنَّكَ لَمِنَ ٱلۡمُصَدِّقِينَ",
   "transliteration": "Yaqoolu ainnaka lamina almusaddiqeena",
   "page": 448
  },
  {
   "id": 53,
   "text": "أَءِذَا مِتۡنَا وَكُنَّا تُرَابٗا وَعِظَٰمًا أَءِنَّا لَمَدِينُونَ",
   "transliteration": "Aitha mitna wakunna turaban waAAithaman ainna lamadeenoona",
   "page": 448
  },
  {
   "id": 54,
   "text": "قَالَ هَلۡ أَنتُم مُّطَّلِعُونَ",
   "transliteration": "Qala hal antum muttaliAAoona",
   "page": 448
  },
  {
   "id": 55,
   "text": "فَٱطَّلَعَ فَرَءَاهُ فِي سَوَآءِ ٱلۡجَحِيمِ",
   "transliteration": "FaittalaAAa faraahu fee sawai aljaheemi",
   "page": 448
  },
  {
   "id": 56,
   "text": "قَالَ تَٱللَّهِ إِن كِدتَّ لَتُرۡدِينِ",
   "transliteration": "Qala taAllahi in kidta laturdeeni",
   "page": 448
  },
  {
   "id": 57,
   "text": "وَلَوۡلَا نِعۡمَةُ رَبِّي لَكُنتُ مِنَ ٱلۡمُحۡضَرِينَ",
   "transliteration": "Walawla niAAmatu rabbee lakuntu mina almuhdareena",
   "page": 448
  },
  {
   "id": 58,
   "text": "أَفَمَا نَحۡنُ بِمَيِّتِينَ",
   "transliteration": "Afama nahnu bimayyiteena",
   "page": 448
  },
  {
   "id": 59,
   "text": "إِلَّا مَوۡتَتَنَا ٱلۡأُولَىٰ وَمَا نَحۡنُ بِمُعَذَّبِينَ",
   "transliteration": "Illa mawtatana aloola wama nahnu bimuAAaththabeena",
   "page": 448
  },
  {
   "id": 60,
   "text": "إِنَّ هَٰذَا لَهُوَ ٱلۡفَوۡزُ ٱلۡعَظِيمُ",
   "transliteration": "Inna hatha lahuwa alfawzu alAAatheemu",
   "page": 448
  },
  {
   "id": 61,
   "text": "لِمِثۡلِ هَٰذَا فَلۡيَعۡمَلِ ٱلۡعَٰمِلُونَ",
   "transliteration": "Limithli hatha falyaAAmali alAAamiloona",
   "page": 448
  },
  {
   "id": 62,
   "text": "أَذَٰلِكَ خَيۡرٞ نُّزُلًا أَمۡ شَجَرَةُ ٱلزَّقُّومِ",
   "transliteration": "Athalika khayrun nuzulan am shajaratu alzzaqqoomi",
   "page": 448
  },
  {
   "id": 63,
   "text": "إِنَّا جَعَلۡنَٰهَا فِتۡنَةٗ لِّلظَّـٰلِمِينَ",
   "transliteration": "Inna jaAAalnaha fitnatan lilththalimeena",
   "page": 448
  },
  {
   "id": 64,
   "text": "إِنَّهَا شَجَرَةٞ تَخۡرُجُ فِيٓ أَصۡلِ ٱلۡجَحِيمِ",
   "transliteration": "Innaha shajaratun takhruju fee asli aljaheemi",
   "page": 448
  },
  {
   "id": 65,
   "text": "طَلۡعُهَا كَأَنَّهُۥ رُءُوسُ ٱلشَّيَٰطِينِ",
   "transliteration": "TalAAuha kaannahu ruoosu alshshayateeni",
   "page": 448
  },
  {
   "id": 66,
   "text": "فَإِنَّهُمۡ لَأٓكِلُونَ مِنۡهَا فَمَالِـُٔونَ مِنۡهَا ٱلۡبُطُونَ",
   "transliteration": "Fainnahum laakiloona minha famalioona minha albutoona",
   "page": 448
  },
  {
   "id": 67,
   "text": "ثُمَّ إِنَّ لَهُمۡ عَلَيۡهَا لَشَوۡبٗا مِّنۡ حَمِيمٖ",
   "transliteration": "Thumma inna lahum AAalayha lashawban min hameemin",
   "page": 448
  },
  {
   "id": 68,
   "text": "ثُمَّ إِنَّ مَرۡجِعَهُمۡ لَإِلَى ٱلۡجَحِيمِ",
   "transliteration": "Thumma inna marjiAAahum laila aljaheemi",
   "page": 448
  },
  {
   "id": 69,
   "text": "إِنَّهُمۡ أَلۡفَوۡاْ ءَابَآءَهُمۡ ضَآلِّينَ",
   "transliteration": "Innahum alfaw abaahum dalleena",
   "page": 448
  },
  {
   "id": 70,
   "text": "فَهُمۡ عَلَىٰٓ ءَاثَٰرِهِمۡ يُهۡرَعُونَ",
   "transliteration": "Fahum AAala atharihim yuhraAAoona",
   "page": 448
  },
  {
   "id": 71,
   "text": "وَلَقَدۡ ضَلَّ قَبۡلَهُمۡ أَكۡثَرُ ٱلۡأَوَّلِينَ",
   "transliteration": "Walaqad dalla qablahum aktharu alawwaleena",
   "page": 448
  },
  {
   "id": 72,
   "text": "وَلَقَدۡ أَرۡسَلۡنَا فِيهِم مُّنذِرِينَ",
   "transliteration": "Walaqad arsalna feehim munthireena",
   "page": 448
  },
  {
   "id": 73,
   "text": "فَٱنظُرۡ كَيۡفَ كَانَ عَٰقِبَةُ ٱلۡمُنذَرِينَ",
   "transliteration": "Faonthur kayfa kana AAaqibatu almunthareena",
   "page": 448
  },
  {
   "id": 74,
   "text": "إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ",
   "transliteration": "Illa AAibada Allahi almukhlaseena",
   "page": 448
  },
  {
   "id": 75,
   "text": "وَلَقَدۡ نَادَىٰنَا نُوحٞ فَلَنِعۡمَ ٱلۡمُجِيبُونَ",
   "transliteration": "Walaqad nadana noohun falaniAAma almujeeboona",
   "page": 448
  },
  {
   "id": 76,
   "text": "وَنَجَّيۡنَٰهُ وَأَهۡلَهُۥ مِنَ ٱلۡكَرۡبِ ٱلۡعَظِيمِ",
   "transliteration": "Wanajjaynahu waahlahu mina alkarbi alAAatheemi",
   "page": 448
  },
  {
   "id": 77,
   "text": "وَجَعَلۡنَا ذُرِّيَّتَهُۥ هُمُ ٱلۡبَاقِينَ",
   "transliteration": "WajaAAalna thurriyyatahu humu albaqeena",
   "page": 449
  },
  {
   "id": 78,
   "text": "وَتَرَكۡنَا عَلَيۡهِ فِي ٱلۡأٓخِرِينَ",
   "transliteration": "Watarakna AAalayhi fee alakhireena",
   "page": 449
  },
  {
   "id": 79,
   "text": "سَلَٰمٌ عَلَىٰ نُوحٖ فِي ٱلۡعَٰلَمِينَ",
   "transliteration": "Salamun AAala noohin fee alAAalameena",
   "page": 449
  },
  {
   "id": 80,
   "text": "إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ",
   "transliteration": "Inna kathalika najzee almuhsineena",
   "page": 449
  },
  {
   "id": 81,
   "text": "إِنَّهُۥ مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِينَ",
   "transliteration": "Innahu min AAibadina almumineena",
   "page": 449
  },
  {
   "id": 82,
   "text": "ثُمَّ أَغۡرَقۡنَا ٱلۡأٓخَرِينَ",
   "transliteration": "Thumma aghraqna alakhareena",
   "page": 449
  },
  {
   "id": 83,
   "text": "۞وَإِنَّ مِن شِيعَتِهِۦ لَإِبۡرَٰهِيمَ",
   "transliteration": "Wainna min sheeAAatihi laibraheema",
   "page": 449
  },
  {
   "id": 84,
   "text": "إِذۡ جَآءَ رَبَّهُۥ بِقَلۡبٖ سَلِيمٍ",
   "transliteration": "Ith jaa rabbahu biqalbin saleemin",
   "page": 449
  },
  {
   "id": 85,
   "text": "إِذۡ قَالَ لِأَبِيهِ وَقَوۡمِهِۦ مَاذَا تَعۡبُدُونَ",
   "transliteration": "Ith qala liabeehi waqawmihi matha taAAbudoona",
   "page": 449
  },
  {
   "id": 86,
   "text": "أَئِفۡكًا ءَالِهَةٗ دُونَ ٱللَّهِ تُرِيدُونَ",
   "transliteration": "Aifkan alihatan doona Allahi tureedoona",
   "page": 449
  },
  {
   "id": 87,
   "text": "فَمَا ظَنُّكُم بِرَبِّ ٱلۡعَٰلَمِينَ",
   "transliteration": "Fama thannukum birabbi alAAalameena",
   "page": 449
  },
  {
   "id": 88,
   "text": "فَنَظَرَ نَظۡرَةٗ فِي ٱلنُّجُومِ",
   "transliteration": "Fanathara nathratan fee alnnujoomi",
   "page": 449
  },
  {
   "id": 89,
   "text": "فَقَالَ إِنِّي سَقِيمٞ",
   "transliteration": "Faqala innee saqeemun",
   "page": 449
  },
  {
   "id": 90,
   "text": "فَتَوَلَّوۡاْ عَنۡهُ مُدۡبِرِينَ",
   "transliteration": "Fatawallaw AAanhu mudbireena",
   "page": 449
  },
  {
   "id": 91,
   "text": "فَرَاغَ إِلَىٰٓ ءَالِهَتِهِمۡ فَقَالَ أَلَا تَأۡكُلُونَ",
   "transliteration": "Faragha ila alihatihim faqala ala takuloona",
   "page": 449
  },
  {
   "id": 92,
   "text": "مَا لَكُمۡ لَا تَنطِقُونَ",
   "transliteration": "Ma lakum la tantiqoona",
   "page": 449
  },
  {
   "id": 93,
   "text": "فَرَاغَ عَلَيۡهِمۡ ضَرۡبَۢا بِٱلۡيَمِينِ",
   "transliteration": "Faragha AAalayhim darban bialyameeni",
   "page": 449
  },
  {
   "id": 94,
   "text": "فَأَقۡبَلُوٓاْ إِلَيۡهِ يَزِفُّونَ",
   "transliteration": "Faaqbaloo ilayhi yaziffoona",
   "page": 449
  },
  {
   "id": 95,
   "text": "قَالَ أَتَعۡبُدُونَ مَا تَنۡحِتُونَ",
   "transliteration": "Qala ataAAbudoona ma tanhitoona",
   "page": 449
  },
  {
   "id": 96,
   "text": "وَٱللَّهُ خَلَقَكُمۡ وَمَا تَعۡمَلُونَ",
   "transliteration": "WaAllahu khalaqakum wama taAAmaloona",
   "page": 449
  },
  {
   "id": 97,
   "text": "قَالُواْ ٱبۡنُواْ لَهُۥ بُنۡيَٰنٗا فَأَلۡقُوهُ فِي ٱلۡجَحِيمِ",
   "transliteration": "Qaloo ibnoo lahu bunyanan faalqoohu fee aljaheemi",
   "page": 449
  },
  {
   "id": 98,
   "text": "فَأَرَادُواْ بِهِۦ كَيۡدٗا فَجَعَلۡنَٰهُمُ ٱلۡأَسۡفَلِينَ",
   "transliteration": "Faaradoo bihi kaydan fajaAAalnahumu alasfaleena",
   "page": 449
  },
  {
   "id": 99,
   "text": "وَقَالَ إِنِّي ذَاهِبٌ إِلَىٰ رَبِّي سَيَهۡدِينِ",
   "transliteration": "Waqala innee thahibun ila rabbee sayahdeeni",
   "page": 449
  },
  {
   "id": 100,
   "text": "رَبِّ هَبۡ لِي مِنَ ٱلصَّـٰلِحِينَ",
   "transliteration": "Rabbi hab lee mina alssaliheena",
   "page": 449
  },
  {
   "id": 101,
   "text": "فَبَشَّرۡنَٰهُ بِغُلَٰمٍ حَلِيمٖ",
   "transliteration": "Fabashsharnahu bighulamin haleemin",
   "page": 449
  },
  {
   "id": 102,
   "text": "فَلَمَّا بَلَغَ مَعَهُ ٱلسَّعۡيَ قَالَ يَٰبُنَيَّ إِنِّيٓ أَرَىٰ فِي ٱلۡمَنَامِ أَنِّيٓ أَذۡبَحُكَ فَٱنظُرۡ مَاذَا تَرَىٰۚ قَالَ يَـٰٓأَبَتِ ٱفۡعَلۡ مَا تُؤۡمَرُۖ سَتَجِدُنِيٓ إِن شَآءَ ٱللَّهُ مِنَ ٱلصَّـٰبِرِينَ",
   "transliteration": "Falamma balagha maAAahu alssaAAya qala ya bunayya innee ara fee almanami annee athbahuka faonthur matha tara qala ya abati ifAAal ma tumaru satajidunee in shaa Allahu mina alssabireena",
   "page": 449
  },
  {
   "id": 103,
   "text": "فَلَمَّآ أَسۡلَمَا وَتَلَّهُۥ لِلۡجَبِينِ",
   "transliteration": "Falamma aslama watallahu liljabeeni",
   "page": 450
  },
  {
   "id": 104,
   "text": "وَنَٰدَيۡنَٰهُ أَن يَـٰٓإِبۡرَٰهِيمُ",
   "transliteration": "Wanadaynahu an ya ibraheemu",
   "page": 450
  },
  {
   "id": 105,
   "text": "قَدۡ صَدَّقۡتَ ٱلرُّءۡيَآۚ إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ",
   "transliteration": "Qad saddaqta alrruya inna kathalika najzee almuhsineena",
   "page": 450
  },
  {
   "id": 106,
   "text": "إِنَّ هَٰذَا لَهُوَ ٱلۡبَلَـٰٓؤُاْ ٱلۡمُبِينُ",
   "transliteration": "Inna hatha lahuwa albalao almubeenu",
   "page": 450
  },
  {
   "id": 107,
   "text": "وَفَدَيۡنَٰهُ بِذِبۡحٍ عَظِيمٖ",
   "transliteration": "Wafadaynahu bithibhin AAatheemin",
   "page": 450
  },
  {
   "id": 108,
   "text": "وَتَرَكۡنَا عَلَيۡهِ فِي ٱلۡأٓخِرِينَ",
   "transliteration": "Watarakna AAalayhi fee alakhireena",
   "page": 450
  },
  {
   "id": 109,
   "text": "سَلَٰمٌ عَلَىٰٓ إِبۡرَٰهِيمَ",
   "transliteration": "Salamun AAala ibraheema",
   "page": 450
  },
  {
   "id": 110,
   "text": "كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ",
   "transliteration": "Kathalika najzee almuhsineena",
   "page": 450
  },
  {
   "id": 111,
   "text": "إِنَّهُۥ مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِينَ",
   "transliteration": "Innahu min AAibadina almumineena",
   "page": 450
  },
  {
   "id": 112,
   "text": "وَبَشَّرۡنَٰهُ بِإِسۡحَٰقَ نَبِيّٗا مِّنَ ٱلصَّـٰلِحِينَ",
   "transliteration": "Wabashsharnahu biishaqa nabiyyan mina alssaliheena",
   "page": 450
  },
  {
   "id": 113,
   "text": "وَبَٰرَكۡنَا عَلَيۡهِ وَعَلَىٰٓ إِسۡحَٰقَۚ وَمِن ذُرِّيَّتِهِمَا مُحۡسِنٞ وَظَالِمٞ لِّنَفۡسِهِۦ مُبِينٞ",
   "transliteration": "Wabarakna AAalayhi waAAala ishaqa wamin thurriyyatihima muhsinun wathalimun linafsihi mubeenun",
   "page": 450
  },
  {
   "id": 114,
   "text": "وَلَقَدۡ مَنَنَّا عَلَىٰ مُوسَىٰ وَهَٰرُونَ",
   "transliteration": "Walaqad mananna AAala moosa waharoona",
   "page": 450
  },
  {
   "id": 115,
   "text": "وَنَجَّيۡنَٰهُمَا وَقَوۡمَهُمَا مِنَ ٱلۡكَرۡبِ ٱلۡعَظِيمِ",
   "transliteration": "Wanajjaynahuma waqawmahuma mina alkarbi alAAatheemi",
   "page": 450
  },
  {
   "id": 116,
   "text": "وَنَصَرۡنَٰهُمۡ فَكَانُواْ هُمُ ٱلۡغَٰلِبِينَ",
   "transliteration": "Wanasarnahum fakanoo humu alghalibeena",
   "page": 450
  },
  {
   "id": 117,
   "text": "وَءَاتَيۡنَٰهُمَا ٱلۡكِتَٰبَ ٱلۡمُسۡتَبِينَ",
   "transliteration": "Waataynahuma alkitaba almustabeena",
   "page": 450
  },
  {
   "id": 118,
   "text": "وَهَدَيۡنَٰهُمَا ٱلصِّرَٰطَ ٱلۡمُسۡتَقِيمَ",
   "transliteration": "Wahadaynahuma alssirata almustaqeema",
   "page": 450
  },
  {
   "id": 119,
   "text": "وَتَرَكۡنَا عَلَيۡهِمَا فِي ٱلۡأٓخِرِينَ",
   "transliteration": "Watarakna AAalayhima fee alakhireena",
   "page": 450
  },
  {
   "id": 120,
   "text": "سَلَٰمٌ عَلَىٰ مُوسَىٰ وَهَٰرُونَ",
   "transliteration": "Salamun AAala moosa waharoona",
   "page": 450
  },
  {
   "id": 121,
   "text": "إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ",
   "transliteration": "Inna kathalika najzee almuhsineena",
   "page": 450
  },
  {
   "id": 122,
   "text": "إِنَّهُمَا مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِينَ",
   "transliteration": "Innahuma min AAibadina almumineena",
   "page": 450
  },
  {
   "id": 123,
   "text": "وَإِنَّ إِلۡيَاسَ لَمِنَ ٱلۡمُرۡسَلِينَ",
   "transliteration": "Wainna ilyasa lamina almursaleena",
   "page": 450
  },
  {
   "id": 124,
   "text": "إِذۡ قَالَ لِقَوۡمِهِۦٓ أَلَا تَتَّقُونَ",
   "transliteration": "Ith qala liqawmihi ala tattaqoona",
   "page": 450
  },
  {
   "id": 125,
   "text": "أَتَدۡعُونَ بَعۡلٗا وَتَذَرُونَ أَحۡسَنَ ٱلۡخَٰلِقِينَ",
   "transliteration": "AtadAAoona baAAlan watatharoona ahsana alkhaliqeena",
   "page": 450
  },
  {
   "id": 126,
   "text": "ٱللَّهَ رَبَّكُمۡ وَرَبَّ ءَابَآئِكُمُ ٱلۡأَوَّلِينَ",
   "transliteration": "Allaha rabbakum warabba abaikumu alawwaleena",
   "page": 450
  },
  {
   "id": 127,
   "text": "فَكَذَّبُوهُ فَإِنَّهُمۡ لَمُحۡضَرُونَ",
   "transliteration": "Fakaththaboohu fainnahum lamuhdaroona",
   "page": 451
  },
  {
   "id": 128,
   "text": "إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ",
   "transliteration": "Illa AAibada Allahi almukhlaseena",
   "page": 451
  },
  {
   "id": 129,
   "text": "وَتَرَكۡنَا عَلَيۡهِ فِي ٱلۡأٓخِرِينَ",
   "transliteration": "Watarakna AAalayhi fee alakhireena",
   "page": 451
  },
  {
   "id": 130,
   "text": "سَلَٰمٌ عَلَىٰٓ إِلۡ يَاسِينَ",
   "transliteration": "Salamun AAala il yaseena",
   "page": 451
  },
  {
   "id": 131,
   "text": "إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ",
   "transliteration": "Inna kathalika najzee almuhsineena",
   "page": 451
  },
  {
   "id": 132,
   "text": "إِنَّهُۥ مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِينَ",
   "transliteration": "Innahu min AAibadina almumineena",
   "page": 451
  },
  {
   "id": 133,
   "text": "وَإِنَّ لُوطٗا لَّمِنَ ٱلۡمُرۡسَلِينَ",
   "transliteration": "Wainna lootan lamina almursaleena",
   "page": 451
  },
  {
   "id": 134,
   "text": "إِذۡ نَجَّيۡنَٰهُ وَأَهۡلَهُۥٓ أَجۡمَعِينَ",
   "transliteration": "Ith najjaynahu waahlahu ajmaAAeena",
   "page": 451
  },
  {
   "id": 135,
   "text": "إِلَّا عَجُوزٗا فِي ٱلۡغَٰبِرِينَ",
   "transliteration": "Illa AAajoozan fee alghabireena",
   "page": 451
  },
  {
