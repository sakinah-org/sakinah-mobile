{
 "id": 101,
 "name": "القارعة",
 "transliteration": "Al-Qari'ah",
 "type": "meccan",
 "total_verses": 11,
 "verses": [
  {
   "id": 1,
   "text": "ٱلۡقَارِعَةُ",
   "transliteration": "AlqariAAatu",
   "page": 600
  },
  {
   "id": 2,
   "text": "مَا ٱلۡقَارِعَةُ",
   "transliteration": "Ma alqariAAatu",
   "page": 600
  },
  {
   "id": 3,
   "text": "وَمَآ أَدۡرَىٰكَ مَا ٱلۡقَارِعَةُ",
   "transliteration": "Wama adraka ma alqariAAatu",
   "page": 600
  },
  {
   "id": 4,
   "text": "يَوۡمَ يَكُونُ ٱلنَّاسُ كَٱلۡفَرَاشِ ٱلۡمَبۡثُوثِ",
   "transliteration": "Yawma yakoonu alnnasu kaalfarashi almabthoothi",
   "page": 600
  },
  {
   "id": 5,
   "text": "وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ ٱلۡمَنفُوشِ",
   "transliteration": "Watakoonu aljibalu kaalAAihni almanfooshi",
   "page": 600
  },
  {
   "id": 6,
   "text": "فَأَمَّا مَن ثَقُلَتۡ مَوَٰزِينُهُۥ",
   "transliteration": "Faamma man thaqulat mawazeenuhu",
   "page": 600
  },
  {
   "id": 7,
   "text": "فَهُوَ فِي عِيشَةٖ رَّاضِيَةٖ",
   "transliteration": "Fahuwa fee AAeeshatin radiyatin",
   "page": 600
  },
  {
   "id": 8,
   "text": "وَأَمَّا مَنۡ خَفَّتۡ مَوَٰزِينُهُۥ",
   "transliteration": "Waamma man khaffat mawazeenuhu",
   "page": 600
  },
  {
   "id": 9,
   "text": "فَأُمُّهُۥ هَاوِيَةٞ",
   "transliteration": "Faommuhu hawiyatun",
   "page": 600
  },
  {
   "id": 10,
   "text": "وَمَآ أَدۡرَىٰكَ مَا هِيَهۡ",
   "transliteration": "Wama adraka ma hiyah",
   "page": 600
  },
  {
   "id": 11,
   "text": "نَارٌ حَامِيَةُۢ",
   "transliteration": "Narun hamiyatun",
   "page": 600
  }
 ]
}