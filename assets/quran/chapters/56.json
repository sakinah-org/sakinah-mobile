{
 "id": 56,
 "name": "الواقعة",
 "transliteration": "Al-Waqi'ah",
 "type": "meccan",
 "total_verses": 96,
 "verses": [
  {
   "id": 1,
   "text": "إِذَا وَقَعَتِ ٱلۡوَاقِعَةُ",
   "transliteration": "Itha waqaAAati alwaqiAAatu",
   "page": 534
  },
  {
   "id": 2,
   "text": "لَيۡسَ لِوَقۡعَتِهَا كَاذِبَةٌ",
   "transliteration": "Laysa liwaqAAatiha kathibatun",
   "page": 534
  },
  {
   "id": 3,
   "text": "خَافِضَةٞ رَّافِعَةٌ",
   "transliteration": "Khafidatun rafiAAatun",
   "page": 534
  },
  {
   "id": 4,
   "text": "إِذَا رُجَّتِ ٱلۡأَرۡضُ رَجّٗا",
   "transliteration": "Itha rujjati alardu rajjan",
   "page": 534
  },
  {
   "id": 5,
   "text": "وَبُسَّتِ ٱلۡجِبَالُ بَسّٗا",
   "transliteration": "Wabussati aljibalu bassan",
   "page": 534
  },
  {
   "id": 6,
   "text": "فَكَانَتۡ هَبَآءٗ مُّنۢبَثّٗا",
   "transliteration": "Fakanat habaan munbaththan",
   "page": 534
  },
  {
   "id": 7,
   "text": "وَكُنتُمۡ أَزۡوَٰجٗا ثَلَٰثَةٗ",
   "transliteration": "Wakuntum azwajan thalathatan",
   "page": 534
  },
  {
   "id": 8,
   "text": "فَأَصۡحَٰبُ ٱلۡمَيۡمَنَةِ مَآ أَصۡحَٰبُ ٱلۡمَيۡمَنَةِ",
   "transliteration": "Faashabu almaymanati ma ashabu almaymanati",
   "page": 534
  },
  {
   "id": 9,
   "text": "وَأَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ مَآ أَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ",
   "transliteration": "Waashabu almashamati ma ashabu almashamati",
   "page": 534
  },
  {
   "id": 10,
   "text": "وَٱلسَّـٰبِقُونَ ٱلسَّـٰبِقُونَ",
   "transliteration": "Waalssabiqoona alssabiqoona",
   "page": 534
  },
  {
   "id": 11,
   "text": "أُوْلَـٰٓئِكَ ٱلۡمُقَرَّبُونَ",
   "transliteration": "Olaika almuqarraboona",
   "page": 534
  },
  {
   "id": 12,
   "text": "فِي جَنَّـٰتِ ٱلنَّعِيمِ",
   "transliteration": "Fee jannati alnnaAAeemi",
   "page": 534
  },
  {
   "id": 13,
   "text": "ثُلَّةٞ مِّنَ ٱلۡأَوَّلِينَ",
   "transliteration": "Thullatun mina alawwaleena",
   "page": 534
  },
  {
   "id": 14,
   "text": "وَقَلِيلٞ مِّنَ ٱلۡأٓخِرِينَ",
   "transliteration": "Waqaleelun mina alakhireena",
   "page": 534
  },
  {
   "id": 15,
   "text": "عَلَىٰ سُرُرٖ مَّوۡضُونَةٖ",
   "transliteration": "AAala sururin mawdoonatin",
   "page": 534
  },
  {
   "id": 16,
   "text": "مُّتَّكِـِٔينَ عَلَيۡهَا مُتَقَٰبِلِينَ",
   "transliteration": "Muttakieena AAalayha mutaqabileena",
   "page": 534
  },
  {
   "id": 17,
   "text": "يَطُوفُ عَلَيۡهِمۡ وِلۡدَٰنٞ مُّخَلَّدُونَ",
   "transliteration": "Yatoofu AAalayhim wildanun mukhalladoona",
   "page": 535
  },
  {
   "id": 18,
   "text": "بِأَكۡوَابٖ وَأَبَارِيقَ وَكَأۡسٖ مِّن مَّعِينٖ",
   "transliteration": "Biakwabin waabareeqa wakasin min maAAeenin",
   "page": 535
  },
  {
   "id": 19,
   "text": "لَّا يُصَدَّعُونَ عَنۡهَا وَلَا يُنزِفُونَ",
   "transliteration": "La yusaddaAAoona AAanha wala yunzifoona",
   "page": 535
  },
  {
   "id": 20,
   "text": "وَفَٰكِهَةٖ مِّمَّا يَتَخَيَّرُونَ",
   "transliteration": "Wafakihatin mimma yatakhayyaroona",
   "page": 535
  },
  {
   "id": 21,
   "text": "وَلَحۡمِ طَيۡرٖ مِّمَّا يَشۡتَهُونَ",
   "transliteration": "Walahmi tayrin mimma yashtahoona",
   "page": 535
  },
  {
   "id": 22,
   "text": "وَحُورٌ عِينٞ",
   "transliteration": "Wahoorun AAeenun",
   "page": 535
  },
  {
   "id": 23,
   "text": "كَأَمۡثَٰلِ ٱللُّؤۡلُوِٕ ٱلۡمَكۡنُونِ",
   "transliteration": "Kaamthali allului almaknooni",
   "page": 535
  },
  {
   "id": 24,
   "text": "جَزَآءَۢ بِمَا كَانُواْ يَعۡمَلُونَ",
   "transliteration": "Jazaan bima kanoo yaAAmaloona",
   "page": 535
  },
  {
   "id": 25,
   "text": "لَا يَسۡمَعُونَ فِيهَا لَغۡوٗا وَلَا تَأۡثِيمًا",
   "transliteration": "La yasmaAAoona feeha laghwan wala tatheeman",
   "page": 535
  },
  {
   "id": 26,
   "text": "إِلَّا قِيلٗا سَلَٰمٗا سَلَٰمٗا",
   "transliteration": "Illa qeelan salaman salaman",
   "page": 535
  },
  {
   "id": 27,
   "text": "وَأَصۡحَٰبُ ٱلۡيَمِينِ مَآ أَصۡحَٰبُ ٱلۡيَمِينِ",
   "transliteration": "Waashabu alyameeni ma ashabu alyameeni",
   "page": 535
  },
  {
   "id": 28,
   "text": "فِي سِدۡرٖ مَّخۡضُودٖ",
   "transliteration": "Fee sidrin makhdoodin",
   "page": 535
  },
  {
   "id": 29,
   "text": "وَطَلۡحٖ مَّنضُودٖ",
   "transliteration": "Watalhin mandoodin",
   "page": 535
  },
  {
   "id": 30,
   "text": "وَظِلّٖ مَّمۡدُودٖ",
   "transliteration": "Wathillin mamdoodin",
   "page": 535
  },
  {
   "id": 31,
   "text": "وَمَآءٖ مَّسۡكُوبٖ",
   "transliteration": "Wamain maskoobin",
   "page": 535
  },
  {
   "id": 32,
   "text": "وَفَٰكِهَةٖ كَثِيرَةٖ",
   "transliteration": "Wafakihatin katheeratin",
   "page": 535
  },
  {
   "id": 33,
   "text": "لَّا مَقۡطُوعَةٖ وَلَا مَمۡنُوعَةٖ",
   "transliteration": "La maqtooAAatin wala mamnooAAatin",
   "page": 535
  },
  {
   "id": 34,
   "text": "وَفُرُشٖ مَّرۡفُوعَةٍ",
   "transliteration": "Wafurushin marfooAAatin",
   "page": 535
  },
  {
   "id": 35,
   "text": "إِنَّآ أَنشَأۡنَٰهُنَّ إِنشَآءٗ",
   "transliteration": "Inna anshanahunna inshaan",
   "page": 535
  },
  {
   "id": 36,
   "text": "فَجَعَلۡنَٰهُنَّ أَبۡكَارًا",
   "transliteration": "FajaAAalnahunna abkaran",
   "page": 535
  },
  {
   "id": 37,
   "text": "عُرُبًا أَتۡرَابٗا",
   "transliteration": "AAuruban atraban",
   "page": 535
  },
  {
   "id": 38,
   "text": "لِّأَصۡحَٰبِ ٱلۡيَمِينِ",
   "transliteration": "Liashabi alyameeni",
   "page": 535
  },
  {
   "id": 39,
   "text": "ثُلَّةٞ مِّنَ ٱلۡأَوَّلِينَ",
   "transliteration": "Thullatun mina alawwaleena",
   "page": 535
  },
  {
   "id": 40,
   "text": "وَثُلَّةٞ مِّنَ ٱلۡأٓخِرِينَ",
   "transliteration": "Wathullatun mina alakhireena",
   "page": 535
  },
  {
   "id": 41,
   "text": "وَأَصۡحَٰبُ ٱلشِّمَالِ مَآ أَصۡحَٰبُ ٱلشِّمَالِ",
   "transliteration": "Waashabu alshshimali ma ashabu alshshimali",
   "page": 535
  },
  {
   "id": 42,
   "text": "فِي سَمُومٖ وَحَمِيمٖ",
   "transliteration": "Fee samoomin wahameemin",
   "page": 535
  },
  {
   "id": 43,
   "text": "وَظِلّٖ مِّن يَحۡمُومٖ",
   "transliteration": "Wathillin min yahmoomin",
   "page": 535
  },
  {
   "id": 44,
   "text": "لَّا بَارِدٖ وَلَا كَرِيمٍ",
   "transliteration": "La baridin wala kareemin",
   "page": 535
  },
  {
   "id": 45,
   "text": "إِنَّهُمۡ كَانُواْ قَبۡلَ ذَٰلِكَ مُتۡرَفِينَ",
   "transliteration": "Innahum kanoo qabla thalika mutrafeena",
   "page": 535
  },
  {
   "id": 46,
   "text": "وَكَانُواْ يُصِرُّونَ عَلَى ٱلۡحِنثِ ٱلۡعَظِيمِ",
   "transliteration": "Wakanoo yusirroona AAala alhinthi alAAatheemi",
   "page": 535
  },
  {
   "id": 47,
   "text": "وَكَانُواْ يَقُولُونَ أَئِذَا مِتۡنَا وَكُنَّا تُرَابٗا وَعِظَٰمًا أَءِنَّا لَمَبۡعُوثُونَ",
   "transliteration": "Wakanoo yaqooloona aitha mitna wakunna turaban waAAithaman ainna lamabAAoothoona",
   "page": 535
  },
  {
   "id": 48,
   "text": "أَوَءَابَآؤُنَا ٱلۡأَوَّلُونَ",
   "transliteration": "Awa abaona alawwaloona",
   "page": 535
  },
  {
   "id": 49,
   "text": "قُلۡ إِنَّ ٱلۡأَوَّلِينَ وَٱلۡأٓخِرِينَ",
   "transliteration": "Qul inna alawwaleena waalakhireena",
   "page": 535
  },
  {
   "id": 50,
   "text": "لَمَجۡمُوعُونَ إِلَىٰ مِيقَٰتِ يَوۡمٖ مَّعۡلُومٖ",
   "transliteration": "LamajmooAAoona ila meeqati yawmin maAAloomin",
   "page": 535
  },
  {
   "id": 51,
   "text": "ثُمَّ إِنَّكُمۡ أَيُّهَا ٱلضَّآلُّونَ ٱلۡمُكَذِّبُونَ",
   "transliteration": "Thumma innakum ayyuha alddalloona almukaththiboona",
   "page": 536
  },
  {
   "id": 52,
   "text": "لَأٓكِلُونَ مِن شَجَرٖ مِّن زَقُّومٖ",
   "transliteration": "Laakiloona min shajarin min zaqqoomin",
   "page": 536
  },
  {
   "id": 53,
   "text": "فَمَالِـُٔونَ مِنۡهَا ٱلۡبُطُونَ",
   "transliteration": "Famalioona minha albutoona",
   "page": 536
  },
  {
   "id": 54,
   "text": "فَشَٰرِبُونَ عَلَيۡهِ مِنَ ٱلۡحَمِيمِ",
   "transliteration": "Fashariboona AAalayhi mina alhameemi",
   "page": 536
  },
  {
   "id": 55,
   "text": "فَشَٰرِبُونَ شُرۡبَ ٱلۡهِيمِ",
   "transliteration": "Fashariboona shurba alheemi",
   "page": 536
  },
  {
   "id": 56,
   "text": "هَٰذَا نُزُلُهُمۡ يَوۡمَ ٱلدِّينِ",
   "transliteration": "Hatha nuzuluhum yawma alddeeni",
   "page": 536
  },
  {
   "id": 57,
   "text": "نَحۡنُ خَلَقۡنَٰكُمۡ فَلَوۡلَا تُصَدِّقُونَ",
   "transliteration": "Nahnu khalaqnakum falawla tusaddiqoona",
   "page": 536
  },
  {
   "id": 58,
   "text": "أَفَرَءَيۡتُم مَّا تُمۡنُونَ",
   "transliteration": "Afaraaytum ma tumnoona",
   "page": 536
  },
  {
   "id": 59,
   "text": "ءَأَنتُمۡ تَخۡلُقُونَهُۥٓ أَمۡ نَحۡنُ ٱلۡخَٰلِقُونَ",
   "transliteration": "Aantum takhluqoonahu am nahnu alkhaliqoona",
   "page": 536
  },
  {
   "id": 60,
   "text": "نَحۡنُ قَدَّرۡنَا بَيۡنَكُمُ ٱلۡمَوۡتَ وَمَا نَحۡنُ بِمَسۡبُوقِينَ",
   "transliteration": "Nahnu qaddarna baynakumu almawta wama nahnu bimasbooqeena",
   "page": 536
  },
  {
   "id": 61,
   "text": "عَلَىٰٓ أَن نُّبَدِّلَ أَمۡثَٰلَكُمۡ وَنُنشِئَكُمۡ فِي مَا لَا تَعۡلَمُونَ",
   "transliteration": "AAala an nubaddila amthalakum wanunshiakum fee ma la taAAlamoona",
   "page": 536
  },
  {
   "id": 62,
   "text": "وَلَقَدۡ عَلِمۡتُمُ ٱلنَّشۡأَةَ ٱلۡأُولَىٰ فَلَوۡلَا تَذَكَّرُونَ",
   "transliteration": "Walaqad AAalimtumu alnnashata aloola falawla tathakkaroona",
   "page": 536
  },
  {
   "id": 63,
   "text": "أَفَرَءَيۡتُم مَّا تَحۡرُثُونَ",
   "transliteration": "Afaraaytum ma tahruthoona",
   "page": 536
  },
  {
   "id": 64,
   "text": "ءَأَنتُمۡ تَزۡرَعُونَهُۥٓ أَمۡ نَحۡنُ ٱلزَّـٰرِعُونَ",
   "transliteration": "Aantum tazraAAoonahu am nahnu alzzariAAoona",
   "page": 536
  },
  {
   "id": 65,
   "text": "لَوۡ نَشَآءُ لَجَعَلۡنَٰهُ حُطَٰمٗا فَظَلۡتُمۡ تَفَكَّهُونَ",
   "transliteration": "Law nashao lajaAAalnahu hutaman fathaltum tafakkahoona",
   "page": 536
  },
  {
   "id": 66,
   "text": "إِنَّا لَمُغۡرَمُونَ",
   "transliteration": "Inna lamughramoona",
   "page": 536
  },
  {
   "id": 67,
   "text": "بَلۡ نَحۡنُ مَحۡرُومُونَ",
   "transliteration": "Bal nahnu mahroomoona",
   "page": 536
  },
  {
   "id": 68,
   "text": "أَفَرَءَيۡتُمُ ٱلۡمَآءَ ٱلَّذِي تَشۡرَبُونَ",
   "transliteration": "Afaraaytumu almaa allathee tashraboona",
   "page": 536
  },
  {
   "id": 69,
   "text": "ءَأَنتُمۡ أَنزَلۡتُمُوهُ مِنَ ٱلۡمُزۡنِ أَمۡ نَحۡنُ ٱلۡمُنزِلُونَ",
   "transliteration": "Aantum anzaltumoohu mina almuzni am nahnu almunziloona",
   "page": 536
  },
  {
   "id": 70,
   "text": "لَوۡ نَشَآءُ جَعَلۡنَٰهُ أُجَاجٗا فَلَوۡلَا تَشۡكُرُونَ",
   "transliteration": "Law nashao jaAAalnahu ojajan falawla tashkuroona",
   "page": 536
  },
  {
   "id": 71,
   "text": "أَفَرَءَيۡتُمُ ٱلنَّارَ ٱلَّتِي تُورُونَ",
   "transliteration": "Afaraaytumu alnnara allatee tooroona",
   "page": 536
  },
  {
   "id": 72,
   "text": "ءَأَنتُمۡ أَنشَأۡتُمۡ شَجَرَتَهَآ أَمۡ نَحۡنُ ٱلۡمُنشِـُٔونَ",
   "transliteration": "Aantum anshatum shajarataha am nahnu almunshioona",
   "page": 536
  },
  {
   "id": 73,
   "text": "نَحۡنُ جَعَلۡنَٰهَا تَذۡكِرَةٗ وَمَتَٰعٗا لِّلۡمُقۡوِينَ",
   "transliteration": "Nahnu jaAAalnaha tathkiratan wamataAAan lilmuqweena",
   "page": 536
  },
  {
   "id": 74,
   "text": "فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِيمِ",
   "transliteration": "Fasabbih biismi rabbika alAAatheemi",
   "page": 536
  },
  {
   "id": 75,
   "text": "۞فَلَآ أُقۡسِمُ بِمَوَٰقِعِ ٱلنُّجُومِ",
   "transliteration": "Fala oqsimu bimawaqiAAi alnnujoomi",
   "page": 536
  },
  {
   "id": 76,
   "text": "وَإِنَّهُۥ لَقَسَمٞ لَّوۡ تَعۡلَمُونَ عَظِيمٌ",
   "transliteration": "Wainnahu laqasamun law taAAlamoona AAatheemun",
   "page": 536
  },
  {
   "id": 77,
   "text": "إِنَّهُۥ لَقُرۡءَانٞ كَرِيمٞ",
   "transliteration": "Innahu laquranun kareemun",
   "page": 537
  },
  {
   "id": 78,
   "text": "فِي كِتَٰبٖ مَّكۡنُونٖ",
   "transliteration": "Fee kitabin maknoonin",
   "page": 537
  },
  {
   "id": 79,
   "text": "لَّا يَمَسُّهُۥٓ إِلَّا ٱلۡمُطَهَّرُونَ",
   "transliteration": "La yamassuhu illa almutahharoona",
   "page": 537
  },
  {
   "id": 80,
   "text": "تَنزِيلٞ مِّن رَّبِّ ٱلۡعَٰلَمِينَ",
   "transliteration": "Tanzeelun min rabbi alAAalameena",
   "page": 537
  },
  {
   "id": 81,
   "text": "أَفَبِهَٰذَا ٱلۡحَدِيثِ أَنتُم مُّدۡهِنُونَ",
   "transliteration": "Afabihatha alhadeethi antum mudhinoona",
   "page": 537
  },
  {
   "id": 82,
   "text": "وَتَجۡعَلُونَ رِزۡقَكُمۡ أَنَّكُمۡ تُكَذِّبُونَ",
   "transliteration": "WatajAAaloona rizqakum annakum tukaththiboona",
   "page": 537
  },
  {
