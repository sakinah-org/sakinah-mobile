 "verses": [
  {
   "id": 1,
   "text": "ٱلرَّحۡمَٰنُ",
   "transliteration": "Alrrahmanu",
   "page": 531
  },
  {
   "id": 2,
   "text": "عَلَّمَ ٱلۡقُرۡءَانَ",
