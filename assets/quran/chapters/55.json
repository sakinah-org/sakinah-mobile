   "page": 531
  },
  {
   "id": 4,
   "text": "عَلَّمَهُ ٱلۡبَيَانَ",
   "transliteration": "AAallamahu albayana",
   "page": 531
  },
  {
   "id": 5,
   "text": "ٱلشَّمۡسُ وَٱلۡقَمَرُ بِحُسۡبَانٖ",
   "transliteration": "Alshshamsu waalqamaru bihusbanin",
   "page": 531
  },
  {
   "id": 6,
   "text": "وَٱلنَّجۡمُ وَٱلشَّجَرُ يَسۡجُدَانِ",
   "transliteration": "Waalnnajmu waalshshajaru yasjudani",
   "page": 531
  },
  {
   "id": 7,
   "text": "وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ٱلۡمِيزَانَ",
